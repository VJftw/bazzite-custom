# Here we set a bunch of parameters for your image build

# output image name, <namespace>/<base>/<variant> under the GHCR owner.
# This is the default variant, used for local builds when no name is given
IMAGE_NAME=bootc/bazzite/godrics-hollow

# GitHub repository name (used for source/readme links in image labels)
REPO_NAME=bootc-images

# Make this the same as your github username/organisation
REPO_ORGANIZATION="VJftw"

IMAGE_DESC="My Customized Bazzite Image"
IMAGE_KEYWORDS="bootc,oci,linux"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
